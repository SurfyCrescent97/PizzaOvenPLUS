<Application x:Class="PizzaOven.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PizzaOven">

    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#202020"/>
            <SolidColorBrush x:Key="SecondaryBrush" Color="#303030"/>
            <SolidColorBrush x:Key="InnerBrush" Color="#000000"/>
            <SolidColorBrush x:Key="LoadingBrush" Color="#ffee5f"/>
			<SolidColorBrush x:Key="TextBrush" Color="#f2f2f2"/>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Controls/Button.xaml"/>
                <ResourceDictionary Source="Controls/ComboBox.xaml"/>
                <ResourceDictionary Source="Controls/ScrollViewer.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>

</Application>