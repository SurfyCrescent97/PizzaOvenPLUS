                                <Button Content="Back" Height="30" HorizontalAlignment="Left" Click="FilterButtonBack_Click"/>
                                <StackPanel Orientation="Vertical" Margin="0,0,0,30" HorizontalAlignment="Left">
                                    <Button x:Name="OpenSuggestForm" Click="OpenLink_Click" Height="30" HorizontalAlignment="Left" Background="#3b82f6" Foreground="{DynamicResource TextBrush}" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="pack://application:,,,/PizzaOven;component/Icons/GoogleForm.png" Height="30" Width="30" Margin="0,0,5,0"/>
                                            <TextBlock Text="Open Suggestion Form" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OpenEmail" Click="OpenLink_Click" Height="30" HorizontalAlignment="Left" Background="#3b82f6" Foreground="{DynamicResource TextBrush}" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="pack://application:,,,/PizzaOven;component/Icons/Email.png" Height="30" Width="30" Margin="0,0,5,0"/>
                                            <TextBlock Text="Open PO+ Email" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OpenTwitterX" Click="OpenLink_Click" Height="30" HorizontalAlignment="Left" Background="#3b82f6" Foreground="{DynamicResource TextBrush}" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="pack://application:,,,/PizzaOven;component/Icons/TwitterX.png" Height="30" Width="30" Margin="0,0,5,0"/>
                                            <TextBlock Text="Open My Personal Twitter/X (may have updates on PO+)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OpenDiscord" Click="OpenLink_Click" Height="30" HorizontalAlignment="Left" Background="#3b82f6" Foreground="{DynamicResource TextBrush}" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="pack://application:,,,/PizzaOven;component/Icons/Discord.png" Height="30" Width="30" Margin="0,0,5,0"/>
                                            <TextBlock Text="Join Our Offical Discord" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button x:Name="OpenMusicYoutube" Click="OpenLink_Click" Height="30" HorizontalAlignment="Left" Background="#3b82f6" Foreground="{DynamicResource TextBrush}" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="pack://application:,,,/PizzaOven;component/Icons/Youtube.png" Height="30" Width="30" Margin="0,0,5,0"/>
                                            <TextBlock Text="LISTEN TO RONNIE'S THEME ON noodlecup's channel" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="0,0,0,10" Tag="App Settings">
                                <Button Content="Back" Height="30" HorizontalAlignment="Left" Click="FilterButtonBack_Click"/>
                                <TextBlock Text="Startup:" Margin="0,5,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <Button x:Name="StartupToggle" Content="Do not open on Device Startup" Height="30" HorizontalAlignment="Left" Click="StartupToggle_Click"/>
                                <Button x:Name="StartupOpen" Content="Open Task Manager Startup" Height="30" HorizontalAlignment="Left" Click="StartupOpen_Click"/>
                                <TextBlock Text="Discord RPC (Displays on Discord):" Margin="0,5,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <Button x:Name="RPCtoggle" Height="35" HorizontalAlignment="Left" Click="RPCtoggle_Click" Foreground="{DynamicResource TextBrush}" Background="#3b82f6" Cursor="Hand" Content="Disable RPC?">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://application:,,,/PizzaOven;component/Icons/Discord.png" Height="30" Width="30" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <TextBlock Text="Low-End Settings(Disables Features to allow a smoother experience for low-end devices):" Margin="0,5,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <Button x:Name="MODUPDATERtoggle" Foreground="{DynamicResource TextBrush}" Content="Disable Check for Mod Updates?" HorizontalAlignment="Left" Click="MODUPDATERtoggle_Click"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Vertical" Margin="0,0,0,20" Tag="Launch Settings">
                                <Button Content="Back" Height="30" HorizontalAlignment="Left" Click="FilterButtonBack_Click"/>
                                <TextBlock Text="Patch Version:" Margin="0,5,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <ComboBox Name="DowngradeCombo" Width="200" Height="30" HorizontalAlignment="Left"/>

                                <TextBlock Text="Downgrade Downloader (USE PATCH VERSION WHEN PATCHING TO USE):" Margin="0,8,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Name="DowngradeDownloadCombo" Width="200" Height="30"/>
                                    <Button Name="DowngradeDownloadButton" Content="Download" Width="90" Height="30" Margin="8,0,0,0" Click="DowngradeDownload_Click"/>
                                </StackPanel>

                                <TextBlock Text="Update your mod to latest Pizza Tower (USES YOUR DOWNGRADES FOLDER TO DETERMINE WHAT TO UPGRADE FROM):" Margin="0,8,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Name="UpgradeXDELTACombo" Width="200" Height="30"/>
                                    <Button Name="UpgradeXDELTA" Content="Update" Width="90" Height="30" Margin="8,0,0,0" Click="UpgradeXDELTA_Click"/>
                                </StackPanel>
                                <TextBlock Text="Folder:" Margin="0,8,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <Button x:Name="OpenPTFolder" Foreground="{DynamicResource TextBrush}" Content="Open Pizza Tower Folder" Height="35" HorizontalAlignment="Left" Click="OpenPTFolder_Click"/>
                                <Button x:Name="ChooseNewPTFolder" Foreground="{DynamicResource TextBrush}" Content="Choose Temporary New Pizza Tower Folder" Height="35" HorizontalAlignment="Left" Click="ChooseNewPTFolder_Click"/>
                                <TextBlock Text="Steam:" Margin="0,8,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <Button x:Name="DebugToggle" Foreground="{DynamicResource TextBrush}" Content="Disable Debug?" Height="35" HorizontalAlignment="Left" Click="DebugToggle_Click"/>
                                <Button x:Name="SteamLaunchToggle" Height="35" HorizontalAlignment="Left" Click="SteamLaunch_Click" Foreground="{DynamicResource TextBrush}" Background="#3b82f6" Cursor="Hand" Content="Use Steam?">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://application:,,,/PizzaOven;component/Icons/Steam.png" Height="30" Width="30" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="0,0,0,10" Tag="Mod Settings">
                                <Button Content="Back" Height="30" HorizontalAlignment="Left" Click="FilterButtonBack_Click"/>
                                <TextBlock Text="PO. Files:" Margin="0,5,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <Button Content="Clean PO. Files" Height="30" HorizontalAlignment="Left" Click="CleanPO_click"/>
                                <Button x:Name="POLanguage" Content="Do not Apply to Language Files" Height="30" HorizontalAlignment="Left" Click="POLanguage_Click"/>
                                <Button x:Name="POOverwriteBackup" Content="Make/Overwrite new data.win.po" Height="30" HorizontalAlignment="Left" Click="POOverwriteBackup_Click"/>
                                <TextBlock Text="Mod Folder (You can set folders by selecting the mod, right clicking and adding a folder name):" Margin="0,5,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="ModFolderCombo" Width="200" Height="30" HorizontalAlignment="Left">
                                    </ComboBox>

                                    <Button x:Name="DeleteModFolderButton" Content="X" Width="25" Height="25" Margin="5,0,0,0" Click="DeleteModFolder_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="Black"/>
                                                <Setter Property="IsEnabled" Value="True"/>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Pizza Tower Folder:" Margin="0,5,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <Button x:Name="SavePTFolderMod" Content="Save Pizza Tower Folder as Mod (Do not upload since contains data.win)" Height="30" HorizontalAlignment="Left" Click="SavePTFolderMod_Click"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Vertical" Margin="0,0,0,20" Tag="App Customization">
                                <Button Content="Back" Height="30" HorizontalAlignment="Left" Click="FilterButtonBack_Click"/>
                                <TextBlock Text="Themes:" Margin="0,5,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Button x:Name="ThemesSave" Content="Save" Height="30" Margin="5,0,0,0" Click="ThemesSave_Click"/>
                                    <Button x:Name="ThemesLoad" Content="Load" Height="30" Margin="5,0,0,0" Click="ThemesLoad_Click"/>
                                    <Button x:Name="ThemesResetAll" Content="Reset All" Height="30" Margin="5,0,0,0" Click="ThemesResetAll_Click"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Theme Presets:" Margin="0,5,0,2" Foreground="{DynamicResource TextBrush}"/>
                                    <ComboBox Name="ThemePresetsCombo" Width="200" Height="30" HorizontalAlignment="Left" SelectedIndex="0"/>
                                    <Button x:Name="ThemePresetsApply" Content="Apply" Height="30" Margin="5,0,0,0" Click="ThemePresetsApply_Click"/>
                                </StackPanel>
                                
                                <TextBlock Text="Theme colors/background:" Margin="0,5,0,2" Foreground="{DynamicResource TextBrush}"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Background:" Width="100" Foreground="{DynamicResource TextBrush}"/>
                                    <Button x:Name="ThemesBackgroundUpload" Content="Upload" Height="30" HorizontalAlignment="Left" Click="ThemesBackgroundUpload_Click"/>
                                    <Button x:Name="ThemesBackgroundReset" Content="Reset" Height="30" Margin="5,0,0,0" Click="ThemesBackgroundReset_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Primary:" Width="100" Foreground="{DynamicResource TextBrush}"/>
                                    <Button x:Name="ThemesPrimary" Content="Select" Height="30" HorizontalAlignment="Left" Click="Theme_Click"/>
                                    <Button x:Name="ThemesPrimaryReset" Content="Reset" Height="30" Margin="5,0,0,0" Click="ThemeReset_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Secondary:" Width="100" Foreground="{DynamicResource TextBrush}"/>
                                    <Button x:Name="ThemesSecondary" Content="Select" Height="30" HorizontalAlignment="Left" Click="Theme_Click"/>
                                    <Button x:Name="ThemesSecondaryReset" Content="Reset" Height="30" Margin="5,0,0,0" Click="ThemeReset_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Inner:" Width="100" Foreground="{DynamicResource TextBrush}"/>
                                    <Button x:Name="ThemesInner" Content="Select" Height="30" HorizontalAlignment="Left" Click="Theme_Click"/>
                                    <Button x:Name="ThemesInnerReset" Content="Reset" Height="30" Margin="5,0,0,0" Click="ThemeReset_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Loading:" Width="100" Foreground="{DynamicResource TextBrush}"/>
                                    <Button x:Name="ThemesLoading" Content="Select" Height="30" HorizontalAlignment="Left" Click="Theme_Click"/>
                                    <Button x:Name="ThemesLoadingReset" Content="Reset" Height="30" Margin="5,0,0,0" Click="ThemeReset_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Text:" Width="100" Foreground="{DynamicResource TextBrush}"/>
                                    <Button x:Name="ThemesText" Content="Select" Height="30" HorizontalAlignment="Left" Click="Theme_Click"/>
                                    <Button x:Name="ThemesTextReset" Content="Reset" Height="30" Margin="5,0,0,0" Click="ThemeReset_Click"/>
                                </StackPanel>
                                
                                <TextBlock Text="Transparent Settings:" Margin="0,5,0,2" Foreground="{DynamicResource TextBrush}"/>
                                
                                <TextBlock Text="Logger:" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="Transparency_Logger" Minimum="0" Maximum="100" Width="120" ValueChanged="Transparent_ValueChanged" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding ElementName=Transparency_Logger, Path=Value, StringFormat={}{0:0}}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>

                                <TextBlock Text="Mod Description:" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="Transparency_ModDescription" Minimum="0" Maximum="100" Width="120" ValueChanged="Transparent_ValueChanged" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding ElementName=Transparency_ModDescription, Path=Value, StringFormat={}{0:0}}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                
                                <TextBlock Text="Mod Grid:" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="Transparency_ModGrid" Minimum="0" Maximum="100" Width="120" ValueChanged="Transparent_ValueChanged" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding ElementName=Transparency_ModGrid, Path=Value, StringFormat={}{0:0}}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                
                                <TextBlock Text="Custom Assets:" Margin="0,5,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <Button x:Name="AssetsFolder" Foreground="{DynamicResource TextBrush}" Content="Open Assets Folder" Height="35" HorizontalAlignment="Left" Click="AssetsFolder_Click"/>
                                <Button x:Name="RestoreMissingAssets" Foreground="{DynamicResource TextBrush}" Content="Restore Missing Assets" Height="35" HorizontalAlignment="Left" Click="RestoreMissingAssets_Click"/>
                                <Button x:Name="RestoreALLAssets" Foreground="{DynamicResource TextBrush}" Content="Restore All Assets" Height="35" HorizontalAlignment="Left" Click="RestoreALLAssets_Click"/>
                                <Button x:Name="MuteButton" Foreground="{DynamicResource TextBrush}" Content="Enable Mute?" Height="35" HorizontalAlignment="Left" Click="Mute_Click"/>
                                <Button x:Name="UnfocusedMuteButton" Foreground="{DynamicResource TextBrush}" Content="Enable Unfocused Mute?" Height="35" HorizontalAlignment="Left" Click="UnfocusedMute_Click"/>
                                <TextBlock Text="Volume:" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="SoundVolume" Minimum="0" Maximum="100" Width="120" ValueChanged="SoundVolume_ValueChanged" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding ElementName=SoundVolume, Path=Value, StringFormat={}{0:0}}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="0,0,0,10" Tag="GMLoader">
                                <Button Content="Back" Height="30" HorizontalAlignment="Left" Click="FilterButtonBack_Click"/>
                                <TextBlock Text="GMLoader by Senjay (allows you to stack mods):" Margin="0,5,0,2" Foreground="{DynamicResource TextBrush}"/>
                                <Button x:Name="GMLoaderConvert" Click="GMLoaderConvert_Click" Height="30" HorizontalAlignment="Left" Background="#3b82f6" Foreground="{DynamicResource TextBrush}" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Source="pack://application:,,,/PizzaOven;component/Icons/GMLoader.png" Height="30" Width="30" Margin="0,0,5,0"/>
                                        <TextBlock Text="Convert XDelta/Win to GMLoader" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="KillGMLoader" Foreground="{DynamicResource TextBrush}" Content="Kill GMLoader (sometimes background gmloader processes mess up PO+)" Height="35" HorizontalAlignment="Left" Click="KillGMLoader_Click"/>
                            </StackPanel>

                            <StackPanel x:Name="CreditsPanel" Tag="Credits" Orientation="Vertical" Margin="0,0,0,20">
                                <Button Content="Back" Height="30" HorizontalAlignment="Left" Click="FilterButtonBack_Click"/>
                                
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Name="PatchNotes" FontSize="18" Header="Latest Patch Notes" Selector.Selected="OnPatchNotesSelected" Background="{DynamicResource SecondaryBrush}">
                <Grid Name="PatchNotesGrid">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <Button Content="Checking for Launcher Updates" Height="30" HorizontalAlignment="Left" Click="CheckLauncherUpdates_Click"/>

                            <TextBlock Text="These are taken from the Gamebanana itself and may have other additional notes (once the update is downloaded it will display)" Margin="0,5,0,10" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>

                            <StackPanel x:Name="PatchNotesPanel" Width="1200"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</Window>
