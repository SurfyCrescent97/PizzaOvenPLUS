<Window x:Class="PizzaOven.UI.PLUSxdeltawindow" 
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
		xmlns:local="clr-namespace:PizzaOven" mc:Ignorable="d" 
		Background="{DynamicResource PrimaryBrush}" 
		WindowStartupLocation="CenterScreen" Height="300" Width="300" MinHeight="300" MaxHeight="300" MinWidth="500" MaxWidth="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Select an XDELTA" Foreground="#f2f2f2" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="1" Text="We have found multiple XDELTAs in this mod, to help speed up the process select the mod one, if you are unsure in the dropbox select unsure and confirm this will slow down the process however (unsure can also serve as all too)" Foreground="#cfcfcf" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="10,0,10,10"/>

        <ComboBox Grid.Row="2" Name="XDeltaCombo" Height="26" Margin="0,5,0,10" Background="#303030" Foreground="#f2f2f2" BorderBrush="#353535"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Name="ConfirmButton" Click="ConfirmButton_Click" Background="#494949" Foreground="#f2f2f2" Margin="110,0,30,10" Content="Confirm"/>

            <Button Name="CancelButton" Click="CancelButton_Click" Background="#494949" Foreground="#f2f2f2" Margin="30,0,110,10" Grid.Column="1" Content="Cancel"/>
        </Grid>
    </Grid>
</Window>